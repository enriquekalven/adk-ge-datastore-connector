# ==============================================================================
# Google Cloud & Gemini Enterprise Connector Environment Configuration
# ==============================================================================

# Core GCP Project Configuration
PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
LOCATION=global
COLLECTION=default_collection
MODEL_NAME=gemini-2.0-flash

# Default Single-Datastore Fallback Settings (Used if agent.yaml has no 'datastores' section)
ENGINE_ID=sharepoint-engine
AUTH_NAME=sharepoint_oauth
AUTH_MODE=USER_OAUTH # Options: USER_OAUTH (Category A), SERVICE_ACCOUNT (Category B/C), HYBRID_DEV (Localhost only)

# Localhost Development Overrides
# ALLOW_ADC_FALLBACK=true # (Optional, localhost dev only. Blocked in Cloud Run / Agent Engine)

